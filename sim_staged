function out = sim_staged(finalPitch,finalTime,dt,latDeg,useRotation)
% STAGED SIMULATOR USED BY WP3 TASK 2 AND WP4

if nargin < 4
    latDeg = 0;
end
if nargin < 5
    useRotation = false;
end

% Constants
g0 = 9.80665;
mu = 3.986004418e14;
rE = 6371000;
rho0 = 1.225;
H = 7200;

m_payload = 4000;

% Stage 1
m_dry1 = 20000;
m_prop1 = 250000;
T1 = 4e6;
Isp1 = 310;
A1 = 10;
Cd1 = 0.35;

% Stage 2
m_dry2 = 6000;
m_prop2 = 65000;
T2 = 7e5;
Isp2 = 360;
A2 = 7;
Cd2 = 0.30;

% Mass flows from common function
p1 = common_physics(0,0,T1,Isp1,Cd1,A1,rho0,H,g0,true);
p2 = common_physics(0,0,T2,Isp2,Cd2,A2,rho0,H,g0,true);
mdot1 = p1.mdot;
mdot2 = p2.mdot;

% Important times
t1 = m_prop1/mdot1;
tIgn = t1+3;
tCut = tIgn+0.946*m_prop2/mdot2;

m0 = m_dry1+m_prop1+m_dry2+m_prop2+m_payload;

% Target and limits
hTarget = 200e3;
rTarget = rE+hTarget;
VTarget = sqrt(mu/rTarget);
limits = [5000 25 25 5000 5000];
Qlimit = 100e3;

% Time includes exact events
time = unique(sort([0:dt:tCut t1 tIgn tCut]))';
N = length(time);

% Initial position
r = [0 rE];
u_r0 = r/norm(r);
u_h0 = [-u_r0(2) u_r0(1)];

% WP4 Earth rotation
omegaE = 7.2921159e-5;
heading = 60;

if useRotation
    vEast0 = omegaE*rE*cosd(latDeg);
    vAlong0 = vEast0*sind(heading);
    omegaPlane = vAlong0/rE;
else
    vAlong0 = 0;
    omegaPlane = 0;
end

v = vAlong0*u_h0;
m = m0;

% Initial airspeed check
vAtm0 = omegaPlane*rE*u_h0;
padAirSpeed = norm(v-vAtm0);

% Histories
altitude = zeros(N,1);
pitchHist = zeros(N,1);
qHist = zeros(N,1);
down = zeros(N,1);
VtHist = zeros(N,1);

pitchHist(1) = 90;
VtHist(1) = dot(v,u_h0);

separated = false;
failed = false;
last = N;

for i = 2:N
    t = time(i-1);
    dti = time(i)-time(i-1);

    % Stage 1 separation
    if t >= t1 && ~separated
        m = m-m_dry1;
        separated = true;
    end

    % Pitch law
    pitch = interp1([0 12 100 190 finalTime 700], ...
                    [90 90 77 20 finalPitch finalPitch],t);

    % Local frame
    rMod = norm(r);
    h = rMod-rE;
    u_r = r/rMod;
    u_h = [-u_r(2) u_r(1)];

    % Atmosphere rotation projected into flight plane
    vAtm = omegaPlane*rMod*u_h;
    vAir = v-vAtm;
    Vair = norm(vAir);

    if Vair > 0
        uAir = vAir/Vair;
    else
        uAir = [0 0];
    end

    % Active stage
    if t < t1
        Tmag = T1;
        Isp = Isp1;
        A = A1;
        Cd = Cd1;
    elseif t < tIgn
        Tmag = 0;
        Isp = 0;
        A = A2;
        Cd = Cd2;
    else
        Tmag = T2;
        Isp = Isp2;
        A = A2;
        Cd = Cd2;
    end

    % Common atmosphere, q, drag and mdot
    p = common_physics(h,Vair,Tmag,Isp,Cd,A,rho0,H,g0,true);

    % Gravity
    g = mu/rMod^2;

    % Forces
    u_T = cosd(pitch)*u_h+sind(pitch)*u_r;
    T = Tmag*u_T;
    W = -m*g*u_r;
    D = -p.D*uAir;

    a = (T+W+D)/m;

    % Forward Euler
    r = r+v*dti;
    v = v+a*dti;
    m = m-p.mdot*dti;

    % Save transverse speed with new local horizontal
    rNew = norm(r);
    u_r_new = r/rNew;
    u_h_new = [-u_r_new(2) u_r_new(1)];
    VtHist(i) = dot(v,u_h_new);

    altitude(i) = norm(r)-rE;
    pitchHist(i) = pitch;
    qHist(i) = p.q;

    angle = atan2(r(2),r(1));
    down(i) = rE*(angle-pi/2);

    if norm(r) <= rE && t > 1
        failed = true;
        last = i;
        break
    end
end

% Final orbit
orb = orbit_from_state(r,v,mu,rE);

err = [abs(orb.rf-rTarget), ...
       abs(orb.Vr), ...
       abs(orb.Vt-VTarget), ...
       abs(orb.hp-hTarget), ...
       abs(orb.ha-hTarget)];

Qmax = max(qHist(1:last));

if ~failed && all(isfinite(err))
    J = max(err./limits);
else
    J = Inf;
end

accepted = ~failed && orb.energy < 0 && orb.hOrb > 0 && orb.hp > 0 ...
    && all(err <= limits) && Qmax <= Qlimit;

% Outputs
out.J = J;
out.err = err;
out.hp = orb.hp;
out.ha = orb.ha;
out.Qmax = Qmax;
out.accepted = accepted;
out.failed = failed;
out.mass = m;

out.time = time(1:last);
out.altitude = altitude(1:last);
out.pitch = pitchHist(1:last);
out.down = down(1:last);
out.VtHist = VtHist(1:last);

out.hcut = orb.rf-rE;
out.Vr = orb.Vr;
out.Vt = orb.Vt;
out.padAirSpeed = padAirSpeed;

out.t1 = t1;
out.tIgn = tIgn;
out.tCut = tCut;
end
