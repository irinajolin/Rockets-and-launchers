function WP3(task)
% WP3 - Task 1 and Task 2

clc; close all;

if nargin < 1
    task = input('WP3 - Choose Task 1 or 2: ');
end

[g0,mu,rE,rho0,~] = constants();

switch task

    case 1
        %% TASK 1 - ONE STAGE VS TWO STAGES

        Isp = 2250;

        % Masses used in the original comparison
        m0 = 46000;
        mprop1 = 10000;
        mprop2 = 8000;
        mdry1 = 12000;
        mdry2 = 10000;
        payload = 6000;

        % Ideal delta-v
        dvSingle = Isp*g0*log(46000/28000);

        dv1 = Isp*g0*log(46000/36000);
        dv2 = Isp*g0*log(24000/16000);
        dvTwo = dv1+dv2;

        fprintf('\nIDEAL DELTA-V\n')
        fprintf('One stage = %.2f m/s\n',dvSingle)
        fprintf('Two stages = %.2f m/s\n',dvTwo)

        MassTable = table(...
            [46000;36000;36000;28000],...
            [46000;36000;24000;16000],...
            'VariableNames',{'OneStage','TwoStages'},...
            'RowNames',{'Initial','AfterStage1Burn','AfterSeparation','Cutoff'});

        disp(MassTable)

        single = sim_task1(false,g0,mu,rE,rho0);
        two = sim_task1(true,g0,mu,rE,rho0);

        fprintf('\nSIMULATED CUTOFF RESULTS\n')
        fprintf('One-stage speed = %.2f m/s\n',single.Vcut)
        fprintf('Two-stage speed = %.2f m/s\n',two.Vcut)

        fprintf('\nCUTOFF SPECIFIC ORBITAL ENERGY\n')
        fprintf('One stage = %.2f J/kg\n',single.energy)
        fprintf('Two stages = %.2f J/kg\n',two.energy)

        fprintf('\nBOUND ORBIT WITH PERIGEE ABOVE SURFACE\n')
        fprintf('One stage = %d\n',single.bound)
        fprintf('Two stages = %d\n',two.bound)

        fprintf('\nSEPARATION CHECK\n')
        fprintf('Velocity before = %.6f m/s\n',two.vBeforeSep)
        fprintf('Velocity after  = %.6f m/s\n',two.vAfterSep)
        fprintf('Difference = %.6f m/s\n',two.vAfterSep-two.vBeforeSep)

        figure
        subplot(1,2,1)
        plot(single.t,single.m,'LineWidth',1.5); hold on
        plot(two.t,two.m,'LineWidth',1.5)
        xlabel('Time [s]'); ylabel('Mass [kg]')
        legend('One stage','Two stages'); grid on

        subplot(1,2,2)
        plot(single.t,single.V,'LineWidth',1.5); hold on
        plot(two.t,two.V,'LineWidth',1.5)
        xlabel('Time [s]'); ylabel('Speed [m/s]')
        legend('One stage','Two stages'); grid on


    case 2
        %% TASK 2 - GRID SEARCH

        pitchGrid = 7.22:0.025:7.42;
        timeGrid = 208:0.5:212;
        dt = 0.0125;

        nPitch = length(pitchGrid);
        nTime = length(timeGrid);
        nCases = nPitch*nTime;

        R = zeros(nCases,13);
        Jmap = zeros(nPitch,nTime);
        acceptedMap = false(nPitch,nTime);

        k = 0;

        for ip = 1:nPitch
            for it = 1:nTime

                k = k+1;

                pf = pitchGrid(ip);
                tf = timeGrid(it);

                out = sim_staged(pf,tf,dt,g0,mu,rE,rho0);

                R(k,:) = [pf tf out.J out.err out.hp out.ha ...
                          out.Qmax out.accepted out.failed];

                Jmap(ip,it) = out.J;
                acceptedMap(ip,it) = out.accepted;
            end
        end

        fprintf('\nGrid simulations = %d\n',nCases)

        % Complete candidate table
        Status = repmat("Completed-unacceptable",nCases,1);
        Status(logical(R(:,12))) = "Acceptable";
        Status(logical(R(:,13))) = "Failed";

        Results = array2table(R(:,1:12));

        Results.Properties.VariableNames = {...
            'Pitch','Time','J','rError','VrError','VtError',...
            'hpError','haError','Perigee','Apogee','Qmax','Accepted'};

        Results.Status = Status;

        disp(Results)

        % Best acceptable flight
        valid = find(R(:,12)==1);

        if isempty(valid)
            disp('NO ACCEPTABLE FLIGHT FOUND')
            return
        end

        [bestJ,pos] = min(R(valid,3));
        bestCase = valid(pos);

        bestPitch = R(bestCase,1);
        bestTime = R(bestCase,2);

        fprintf('\nBEST FLIGHT\n')
        fprintf('Pitch = %.3f deg\n',bestPitch)
        fprintf('Time = %.1f s\n',bestTime)
        fprintf('J = %.4f\n',bestJ)

        % Starting, best and dt/2
        start = sim_staged(7.42,212,dt,g0,mu,rE,rho0);
        best = sim_staged(bestPitch,bestTime,dt,g0,mu,rE,rho0);
        bestHalf = sim_staged(bestPitch,bestTime,dt/2,g0,mu,rE,rho0);

        fprintf('\nSTARTING / BEST / dt/2\n')
        fprintf('Starting: J = %.4f, Accepted = %d\n',start.J,start.accepted)
        fprintf('Best:     J = %.4f, Accepted = %d\n',best.J,best.accepted)
        fprintf('dt/2:     J = %.4f, Accepted = %d\n',bestHalf.J,bestHalf.accepted)

        fprintf('\nSTAGE EVENTS\n')
        fprintf('Stage 1 burnout = %.2f s\n',best.t1)
        fprintf('Stage 2 ignition = %.2f s\n',best.tIgn)
        fprintf('Final cutoff = %.2f s\n',best.tCut)
        fprintf('Final attached mass = %.2f kg\n',best.mass)

        % Physical checks at dt and dt/2
        CheckName = [...
            "Radius";
            "Radial velocity";
            "Tangential velocity";
            "Perigee";
            "Apogee";
            "Maximum Q"];

        Limit = [5000;25;25;5000;5000;100e3];

        BestValue = [best.err(:);best.Qmax];
        HalfValue = [bestHalf.err(:);bestHalf.Qmax];

        CheckTable = table(...
            CheckName,BestValue,HalfValue,Limit,...
            BestValue<=Limit,HalfValue<=Limit,...
            'VariableNames',{'Check','dt','dt_2','Limit','Pass_dt','Pass_dt_2'});

        disp(CheckTable)

        fprintf('\nORBIT CHECKS FOR BEST\n')
        fprintf('Bound orbit = %d\n',best.energy < 0)
        fprintf('Non-zero angular momentum = %d\n',best.hOrb > 0)
        fprintf('Perigee above surface = %d\n',best.hp > 0)

        % Objective map
        Jplot = Jmap;
        Jplot(~isfinite(Jplot)) = NaN;

        figure
        imagesc(timeGrid,pitchGrid,Jplot)
        set(gca,'YDir','normal')
        colorbar; hold on

        [row,col] = find(acceptedMap);
        scatter(timeGrid(col),pitchGrid(row),50,'o','LineWidth',1.5)
        plot(bestTime,bestPitch,'kp','MarkerSize',14,'LineWidth',2)

        xlabel('Final pitch time [s]')
        ylabel('Final pitch [deg]')
        title('Objective J')

        % Starting vs best
        figure
        subplot(2,1,1)
        plot(start.down/1000,start.altitude/1000,'LineWidth',1.5); hold on
        plot(best.down/1000,best.altitude/1000,'LineWidth',1.5)
        xlabel('Downrange [km]'); ylabel('Altitude [km]')
        legend('Starting','Best'); grid on

        subplot(2,1,2)
        plot(start.time,start.pitch,'LineWidth',1.5); hold on
        plot(best.time,best.pitch,'LineWidth',1.5)
        xlabel('Time [s]'); ylabel('Pitch [deg]')
        legend('Starting','Best'); grid on

    otherwise
        disp('Choose Task 1 or Task 2')
end

end


function out = sim_task1(twoStage,g0,mu,rE,rho0)

H = 9500;
Cd = 0.5;
Cl = 0.5;

d = 3.5;
A = pi*(d/2)^2;

m0 = 46000;

mprop1 = 10000;
mprop2 = 8000;
mdry1 = 12000;

T0 = 650000;
Isp = 2250;

mdot = mass_flow(T0,Isp,g0);

t1 = mprop1/mdot;
tCut = (mprop1+mprop2)/mdot;

dt = 0.1;
time = unique(sort([0:dt:tCut t1 tCut]))';
N = length(time);

r = [0 rE];
v = [0 0];
m = m0;

mHist = zeros(N,1);
VHist = zeros(N,1);

mHist(1) = m0;

separated = false;
vBeforeSep = NaN;
vAfterSep = NaN;

for i = 2:N

    t = time(i-1);
    dti = time(i)-time(i-1);

    if twoStage && t >= t1 && ~separated
        vBeforeSep = norm(v);
        m = m-mdry1;
        vAfterSep = norm(v);
        separated = true;
    end

    if t < 500
        pitch = 90-90*t/500;
    else
        pitch = 0;
    end

    rMod = norm(r);
    h = rMod-rE;

    u_r = r/rMod;
    u_h = [-u_r(2) u_r(1)];

    V = norm(v);

    if V > 0
        u_v = v/V;
        u_perp = [-u_v(2) u_v(1)];
    else
        u_v = [0 0];
        u_perp = [0 0];
    end

    [~,q,Dmag] = atmosphere_drag(h,V,Cd,A,rho0,H,true);

    g = mu/rMod^2;

    T = T0*(cosd(pitch)*u_h+sind(pitch)*u_r);
    W = -m*g*u_r;
    D = -Dmag*u_v;
    L = -q*Cl*A*u_perp;

    a = (T+W+D+L)/m;

    % Forward Euler
    r = r+v*dti;
    v = v+a*dti;
    m = m-mdot*dti;

    mHist(i) = m;
    VHist(i) = norm(v);
end

orb = orbit_from_state(r,v,mu,rE);

out.t = time;
out.m = mHist;
out.V = VHist;

out.Vcut = norm(v);
out.energy = orb.energy;
out.hp = orb.hp;
out.bound = orb.energy < 0 && orb.hp > 0;

out.vBeforeSep = vBeforeSep;
out.vAfterSep = vAfterSep;

end


function out = sim_staged(finalPitch,finalTime,dt,g0,mu,rE,rho0)

% Stage 1
mDry1 = 20000;
mProp1 = 250000;
T1 = 4e6;
Isp1 = 310;
A1 = 10;
Cd1 = 0.35;

% Stage 2
mDry2 = 6000;
mProp2 = 65000;
T2 = 7e5;
Isp2 = 360;
A2 = 7;
Cd2 = 0.30;

payload = 4000;
H = 7200;

mdot1 = mass_flow(T1,Isp1,g0);
mdot2 = mass_flow(T2,Isp2,g0);

t1 = mProp1/mdot1;
tIgn = t1+3;
tCut = tIgn+0.946*mProp2/mdot2;

m = mDry1+mProp1+mDry2+mProp2+payload;

% Target and limits
hTarget = 200e3;
rTarget = rE+hTarget;
VTarget = sqrt(mu/rTarget);

limits = [5000 25 25 5000 5000];
Qlimit = 100e3;

time = unique(sort([0:dt:tCut t1 tIgn tCut]))';
N = length(time);

r = [0 rE];
v = [0 0];

altitude = zeros(N,1);
pitchHist = zeros(N,1);
qHist = zeros(N,1);
down = zeros(N,1);

pitchHist(1) = 90;

separated = false;
failed = false;
last = N;

for i = 2:N

    t = time(i-1);
    dti = time(i)-time(i-1);

    if t >= t1 && ~separated
        m = m-mDry1;
        separated = true;
    end

    pitch = interp1([0 12 100 190 finalTime 700],...
                    [90 90 77 20 finalPitch finalPitch],t);

    rMod = norm(r);
    h = rMod-rE;

    u_r = r/rMod;
    u_h = [-u_r(2) u_r(1)];

    V = norm(v);

    if V > 0
        u_v = v/V;
    else
        u_v = [0 0];
    end

    if t < t1
        Tmag = T1;
        Isp = Isp1;
        A = A1;
        Cd = Cd1;

    elseif t < tIgn
        Tmag = 0;
        Isp = 0;
        A = A2;
        Cd = Cd2;

    else
        Tmag = T2;
        Isp = Isp2;
        A = A2;
        Cd = Cd2;
    end

    [~,q,Dmag] = atmosphere_drag(h,V,Cd,A,rho0,H,true);
    mdot = mass_flow(Tmag,Isp,g0);

    g = mu/rMod^2;

    T = Tmag*(cosd(pitch)*u_h+sind(pitch)*u_r);
    W = -m*g*u_r;
    D = -Dmag*u_v;

    a = (T+W+D)/m;

    % Forward Euler
    r = r+v*dti;
    v = v+a*dti;
    m = m-mdot*dti;

    altitude(i) = norm(r)-rE;
    pitchHist(i) = pitch;
    qHist(i) = q;

    angle = atan2(r(2),r(1));
    down(i) = rE*(angle-pi/2);

    if norm(r) <= rE && t > 1
        failed = true;
        last = i;
        break
    end
end

orb = orbit_from_state(r,v,mu,rE);

err = [...
    abs(orb.rf-rTarget),...
    abs(orb.Vr),...
    abs(orb.Vt-VTarget),...
    abs(orb.hp-hTarget),...
    abs(orb.ha-hTarget)];

Qmax = max(qHist(1:last));

if ~failed && all(isfinite(err))
    J = max(err./limits);
else
    J = Inf;
end

accepted = ~failed && orb.energy < 0 && orb.hOrb > 0 && orb.hp > 0 ...
           && all(err <= limits) && Qmax <= Qlimit;

out.J = J;
out.err = err;

out.hp = orb.hp;
out.ha = orb.ha;
out.energy = orb.energy;
out.hOrb = orb.hOrb;

out.Qmax = Qmax;
out.accepted = accepted;
out.failed = failed;

out.mass = m;

out.time = time(1:last);
out.altitude = altitude(1:last);
out.pitch = pitchHist(1:last);
out.down = down(1:last);

out.t1 = t1;
out.tIgn = tIgn;
out.tCut = tCut;

end
