function p = common_physics(h,Vair,T,Isp,Cd,A,rho0,H,g0,useAtmosphere)
% COMMON PHYSICS USED THROUGHOUT THE PROJECT
% Atmosphere, dynamic pressure, drag magnitude and mass flow.

if nargin < 10
    useAtmosphere = true;
end

% Atmosphere
if useAtmosphere
    p.rho = rho0*exp(-max(h,0)/H);
else
    p.rho = 0;
end

% Dynamic pressure
p.q = 0.5*p.rho*Vair^2;

% Drag magnitude
p.D = p.q*Cd*A;

% Propellant mass flow
if T > 0 && Isp > 0
    p.mdot = T/(Isp*g0);
else
    p.mdot = 0;
end
end
