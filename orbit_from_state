function orb = orbit_from_state(r,v,mu,rE)

rf = norm(r);
Vf = norm(v);

u_r = r/rf;
u_h = [-u_r(2) u_r(1)];

orb.rf = rf;
orb.Vr = dot(v,u_r);
orb.Vt = dot(v,u_h);

orb.energy = Vf^2/2-mu/rf;
orb.hOrb = abs(r(1)*v(2)-r(2)*v(1));

if orb.hOrb > 0
    orb.e = sqrt(max(0,1+2*orb.energy*orb.hOrb^2/mu^2));

    rp = (orb.hOrb^2/mu)/(1+orb.e);
    orb.hp = rp-rE;

    if orb.energy < 0
        a = -mu/(2*orb.energy);
        orb.ha = a*(1+orb.e)-rE;
    else
        orb.ha = Inf;
    end
else
    orb.e = NaN;
    orb.hp = NaN;
    orb.ha = Inf;
end

end
