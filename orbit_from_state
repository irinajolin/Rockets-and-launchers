function orb = orbit_from_state(r,v,mu,rE)
% ORBITAL QUANTITIES FROM A 2D INERTIAL STATE
% Used in WP2, WP3 and WP4.

rf = norm(r);
Vf = norm(v);

u_r = r/rf;
u_h = [-u_r(2) u_r(1)];

Vr = dot(v,u_r);
Vt = dot(v,u_h);

energy = Vf^2/2-mu/rf;
hOrb = abs(r(1)*v(2)-r(2)*v(1));

if hOrb > 0
    e = sqrt(max(0,1+2*energy*hOrb^2/mu^2));
    rp = (hOrb^2/mu)/(1+e);
    hp = rp-rE;

    if energy < 0
        a = -mu/(2*energy);
        ra = a*(1+e);
        ha = ra-rE;
    else
        a = Inf;
        ra = Inf;
        ha = Inf;
    end
else
    e = NaN;
    a = NaN;
    rp = NaN;
    ra = Inf;
    hp = NaN;
    ha = Inf;
end

orb.rf = rf;
orb.Vf = Vf;
orb.Vr = Vr;
orb.Vt = Vt;
orb.energy = energy;
orb.hOrb = hOrb;
orb.e = e;
orb.a = a;
orb.rp = rp;
orb.ra = ra;
orb.hp = hp;
orb.ha = ha;
end
