clear;
clc;
close all;

% PROBLEM 1A - STARSHIP CO2 EMISSIONS

% Propellant capacities - SpaceX
m_prop_booster = 3650e3;    % kg
m_prop_starship = 1600e3;   % kg

% Molecular masses
M_CH4 = 16;    % kg/kmol
M_O2  = 32;    % kg/kmol
M_CO2 = 44;    % kg/kmol
M_CO = 28;      % kg/kmol
M_H2O = 18;     % kg/kmol

% Reference Raptor mixture ratio - FAA 2019
OF = 3.60;    % m_O2/m_CH4



%%PROBLEM 1 
%a)
% 1. CALCULATE METHANE AND OXYGEN MASSES --> 

% Super Heavy
[m_CH4_booster,m_O2_booster] = propellant_masses(m_prop_booster,OF);

% Starship
[m_CH4_starship,m_O2_starship] = propellant_masses(m_prop_starship,OF);


% 2. CALCULATE CO2 EMISSIONS

% Super Heavy
[m_CO2_booster,m_CO2_total_booster] = combustion_methane(m_CH4_booster,m_O2_booster,M_CH4,M_O2,M_CO2);

% Starship
[m_CO2_starship,m_CO2_total_starship] = combustion_methane(m_CH4_starship,m_O2_starship,M_CH4,M_O2,M_CO2);


% 3. TOTAL CO2 EMISSIONS

m_CO2 = m_CO2_booster + m_CO2_starship;

m_CO2_total = m_CO2_total_booster + m_CO2_total_starship;


% 4. RESULTS

fprintf('SUPER HEAVY\n');
fprintf('Direct CO2 emissions = %.2f tonnes\n',m_CO2_booster/1000);
fprintf('CO2 if all CO is oxidized = %.2f tonnes\n\n', ...
        m_CO2_total_booster/1000);

fprintf('STARSHIP\n');
fprintf('Direct CO2 emissions = %.2f tonnes\n',m_CO2_starship/1000);
fprintf('CO2 if all CO is oxidized = %.2f tonnes\n\n', ...
        m_CO2_total_starship/1000);

fprintf('TOTAL STARSHIP / SUPER HEAVY\n');
fprintf('Direct CO2 emissions = %.2f tonnes\n',m_CO2/1000);
fprintf('CO2 if all CO is oxidized = %.2f tonnes\n', ...
        m_CO2_total/1000);

% MASS CONSERVATION VERIFICATION

% Super Heavy
[error_prop_booster,error_comb_booster] = ...
    mass_conservation(m_prop_booster,m_CH4_booster,m_O2_booster, ...
    m_CO2_booster,M_CH4,M_CO2,M_CO,M_H2O);

% Starship
[error_prop_starship,error_comb_starship] = ...
    mass_conservation(m_prop_starship,m_CH4_starship,m_O2_starship, ...
    m_CO2_starship,M_CH4,M_CO2,M_CO,M_H2O);

fprintf('\nMASS CONSERVATION VERIFICATION\n');
fprintf('Super Heavy propellant error = %.3e kg\n',error_prop_booster);
fprintf('Super Heavy combustion error = %.3e\n',error_comb_booster);
fprintf('Starship propellant error = %.3e kg\n',error_prop_starship);
fprintf('Starship combustion error = %.3e\n',error_comb_starship);


% CO2 COMPARISON - PROBLEM 1A

% Reference conditions
T_ref = 298.15;     % K
P_ref = 101325;     % Pa

% Specific gas constant for CO2
R0 = 8314.462618;   % J/(kmol*K)
Rs_CO2 = R0/M_CO2;   % J/(kg*K)

% Calculate CO2 density
[rho_CO2,~,~,~,~] = ideal_gas([],Rs_CO2,P_ref,T_ref,[],m_CO2_total);

% Calculate CO2 volume
[~,~,~,V_CO2,~] = ideal_gas(rho_CO2,Rs_CO2,P_ref,T_ref,[],m_CO2_total);

% Swimming pool comparison
V_pool = 50*25*2;     % m^3

n_pools = V_CO2/V_pool;

% Results
fprintf('\nCO2 COMPARISON\n');
fprintf('CO2 density = %.3f kg/m3\n',rho_CO2);
fprintf('CO2 volume = %.2f m3\n',V_CO2);
fprintf('Equivalent swimming pools = %.2f\n',n_pools);



% PROBLEM 1B - STARLINK CO2 EMISSIONS

% Number of Starlink launches, 2019-2026
% Cut-off: November 17, 2026

years = 2019:2026;

N_falcon9 = [2 14 17 34 63 89 122 85];
N_starship = [0 0 0 0 0 0 0 2];

N_F9_total = sum(N_falcon9);
N_starship_total = sum(N_starship);

% 1. FALCON 9 PROPELLANTS

% Reference values - Lawrence Berkeley National Laboratory
m_RP1_F9 = 155893;  % kg per launch
m_LOX_F9 = 362607;  % kg per launch

m_prop_F9 = m_RP1_F9 + m_LOX_F9;

% Molecular masses [kg/kmol]
M_RP1 = 170;  % C12H26
M_O2 = 32;
M_CO2 = 44;
M_H2O = 18;

% 2. FALCON 9 COMBUSTION

[m_CO2_F9,m_O2_required_F9,m_H2O_F9] = ...
    combustion_RP1(m_RP1_F9,M_RP1,M_O2,M_CO2,M_H2O);

% Potential CO2 from all Falcon 9 Starlink launches
m_CO2_F9_total = N_F9_total*m_CO2_F9;

% 3. STARSHIP COMBUSTION

% Reuse the potential CO2 calculated in Problem 1A
m_CO2_starship_launch = m_CO2_total;

% Potential CO2 from Starship Starlink launches
m_CO2_starship_total = ...
    N_starship_total*m_CO2_starship_launch;

% 4. TOTAL STARLINK CO2

m_CO2_starlink = ...
    m_CO2_F9_total + m_CO2_starship_total;

% 5. ROAD TRANSPORT COMPARISON

% Petrol car emissions: 170 g CO2/km
emissions_car = 0.170;  % kg/km

km_equivalent = m_CO2_starlink/emissions_car;

% 6. VERIFICATION

% Conservation of mass in complete RP-1 oxidation
error_RP1 = abs((m_RP1_F9+m_O2_required_F9) ...
             - (m_CO2_F9+m_H2O_F9));

% Compare actual rocket O/F with stoichiometric O/F
OF_F9 = m_LOX_F9/m_RP1_F9;

OF_stoich = m_O2_required_F9/m_RP1_F9;

% 7. RESULTS

fprintf('\n--- PROBLEM 1B: STARLINK ---\n');

fprintf('Falcon 9 launches = %d\n',N_F9_total);
fprintf('Starship launches = %d\n',N_starship_total);

fprintf('\nFALCON 9\n');
fprintf('Propellant per launch = %.2f tonnes\n', ...
    m_prop_F9/1000);
fprintf('RP-1 per launch = %.2f tonnes\n', ...
    m_RP1_F9/1000);
fprintf('CO2 per launch = %.2f tonnes\n', ...
    m_CO2_F9/1000);
fprintf('Total Falcon 9 CO2 = %.2f tonnes\n', ...
    m_CO2_F9_total/1000);

fprintf('\nSTARSHIP\n');
fprintf('Total Starship CO2 = %.2f tonnes\n', ...
    m_CO2_starship_total/1000);

fprintf('\nTOTAL STARLINK\n');
fprintf('Total CO2 = %.2f tonnes\n', ...
    m_CO2_starlink/1000);
fprintf('Equivalent car distance = %.2f km\n', ...
    km_equivalent);

fprintf('\nVERIFICATION\n');
fprintf('RP-1 mass error = %.3e kg\n',error_RP1);
fprintf('Falcon 9 O/F = %.3f\n',OF_F9);
fprintf('Stoichiometric O/F = %.3f\n',OF_stoich);

% 8. YEARLY CO2 EMISSIONS

m_CO2_year = N_falcon9*m_CO2_F9 + N_starship*m_CO2_starship_launch;

figure;
bar(years,m_CO2_year/1e6);
xlabel('Year');
ylabel('Potential CO2 emissions [thousand tonnes]');
title('Estimated Starlink launch CO2 emissions by year');
grid on;


